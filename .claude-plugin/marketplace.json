{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "camomilekr",
  "description": "camomilekr가 만든 Claude Code 플러그인 마켓플레이스",
  "owner": {
    "name": "Jiho Seo",
    "email": "camomile.kr@gmail.com",
    "url": "https://github.com/camomilekr"
  },
  "plugins": [
    {
      "name": "ide-notify",
      "description": "Claude Code가 작업을 마치거나, 서브에이전트가 작업을 시작·완료했거나, 승인·결정을 기다릴 때 시스템 알림을 보냅니다. macOS에서는 알림을 클릭하면 세션을 띄운 터미널/IDE로 포커스가 이동합니다.",
      "author": {
        "name": "Jiho Seo",
        "email": "camomile.kr@gmail.com",
        "url": "https://github.com/camomilekr"
      },
      "homepage": "https://github.com/camomilekr/claude-code-plugins/tree/main/plugins/ide-notify",
      "repository": "https://github.com/camomilekr/claude-code-plugins",
      "license": "MIT",
      "category": "productivity",
      "keywords": ["notification", "macos", "linux", "windows", "hooks", "focus"],
      "source": "./plugins/ide-notify"
    },
    {
      "name": "code-review-plugins",
      "description": "코드 리뷰 대응 자동화 스킬 모음. 사람 리뷰어와 CodeRabbit·Copilot 같은 자동 리뷰를 가리지 않고 PR 리뷰 코멘트를 코드로 검증해 타당한 지적은 수정 후 수정 내용 답글을, 부적절한 지적은 근거를 들어 반박 답글을 작성하는 response-to-review 스킬을 제공합니다.",
      "author": {
        "name": "Jiho Seo",
        "email": "camomile.kr@gmail.com",
        "url": "https://github.com/camomilekr"
      },
      "homepage": "https://github.com/camomilekr/claude-code-plugins/tree/main/plugins/code-review",
      "repository": "https://github.com/camomilekr/claude-code-plugins",
      "license": "MIT",
      "category": "productivity",
      "keywords": ["code-review", "review-response", "coderabbit", "copilot", "pr", "github", "skill"],
      "source": "./plugins/code-review"
    },
    {
      "name": "git-workflow",
      "description": "Jira 티켓에서 시작하는 architect → developer ↔ reviewer 개발 파이프라인. 티어 판정, 계획·구현·검토 루프, 커밋·PR, Jira 상태 전환 규칙과 에이전트를 제공합니다.",
      "author": {
        "name": "Jiho Seo",
        "email": "camomile.kr@gmail.com",
        "url": "https://github.com/camomilekr"
      },
      "homepage": "https://github.com/camomilekr/claude-code-plugins/tree/main/plugins/git-workflow",
      "repository": "https://github.com/camomilekr/claude-code-plugins",
      "license": "MIT",
      "category": "productivity",
      "keywords": ["git", "workflow", "rules"],
      "source": "./plugins/git-workflow"
    },
    {
      "name": "spec-driven-workflow",
      "description": "스펙 주도 단방향 개발 파이프라인. architect(계획) → spec-writer(실패하는 스펙 테스트로 완료 기준 고정) → developer(스펙을 green으로) → 결정론적 게이트 → 검토 1회로 진행합니다. developer ↔ reviewer 왕복 루프 없이, 검증을 결정론적 게이트와 새 컨텍스트 경계로 대체하는 것이 git-workflow 플러그인과의 차이입니다.",
      "author": {
        "name": "Jiho Seo",
        "email": "camomile.kr@gmail.com",
        "url": "https://github.com/camomilekr"
      },
      "homepage": "https://github.com/camomilekr/claude-code-plugins/tree/main/plugins/spec-driven-workflow",
      "repository": "https://github.com/camomilekr/claude-code-plugins",
      "license": "MIT",
      "category": "productivity",
      "keywords": ["git", "workflow", "spec-driven", "tdd", "rules"],
      "source": "./plugins/spec-driven-workflow"
    }
  ]
}
